# Names only, never real values. Copy to .env locally (it is git-ignored).
# Client secrets are referenced BY NAME from clients/<client>/client.yaml.

# ---- process settings (all optional) ----
# SALES_AGENT_CLIENTS_DIR=clients
# Versioned client settings (sales-agent config ...). Outside git; include it in backups.
# SALES_AGENT_CONFIG_DIR=config
# SALES_AGENT_LOG_LEVEL=INFO
# Highest mode any client may run in. Default "approval": autonomous mode is impossible
# unless the deployment sets SALES_AGENT_MODE_CEILING=autonomous.
# SALES_AGENT_MODE_CEILING=approval
# SALES_AGENT_HOST=127.0.0.1
# SALES_AGENT_PORT=8000
# SALES_AGENT_LOCK_FILE=.sales-agent.lock
# Write Revansa's results back into a client's Google Sheet. OFF by default and to stay off until the
# mechanism has been validated against a real Google Sheet. A source also needs its own `writeback`
# block (the columns, named one by one) and the database (the attempts are kept there).
# SALES_AGENT_WRITEBACK_ENABLED=false

# ---- Admin Revansa (accounts and sessions, sales_app.admin_auth) ----
# SALES_AGENT_ADMIN_DIR=admin
# SALES_AGENT_ADMIN_SESSION_TTL_HOURS=24
# False only for local http development; a real deployment must keep this true.
# SALES_AGENT_ADMIN_COOKIE_SECURE=true

# ---- database (sales_app.persistence; see docs/persistence.md) ----
# Where accounts, client profiles, sessions and versioned settings live. PostgreSQL in production:
#   SALES_AGENT_DATABASE_URL=postgresql://revansa:CHANGE_ME@localhost:5432/revansa
# Create the schema with `sales-agent db upgrade`; move existing file data with `sales-agent db import`.
# Unset: the JSON files in SALES_AGENT_ADMIN_DIR / profiles / SALES_AGENT_CONFIG_DIR (fallback).
# The password in the URL is never printed or logged. Credentials never go in the database.
# SALES_AGENT_DATABASE_URL=

# ---- credential store (sales_app.secret_store) ----
# Master key that opens the encrypted credentials saved from Admin Settings. 32 random bytes in
# base64: create one with `sales-agent secrets generate-key`. Keep it apart from backups of
# SALES_AGENT_SECRETS_DIR. If the secrets file exists and this is missing, startup is refused.
# SALES_AGENT_SECRETS_KEY=
# SALES_AGENT_SECRETS_DIR=secrets

# ---- public address (Telegram webhook) ----
# The https address Telegram can reach this deployment on; a client's bot is connected to
# <this address>/webhooks/telegram. No trailing path, never a secret. Without it a Telegram bot can
# be saved and tested but not connected. Telegram delivers only to https (ports 443, 80, 88, 8443).
# The value below is a fictitious example: replace it with your own address.
# SALES_AGENT_PUBLIC_BASE_URL=https://revansa.example.invalid

# ---- shared ----
OPENAI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json
# Meta webhook subscription check (GET /webhooks/whatsapp)
WHATSAPP_VERIFY_TOKEN=

# ---- Naga ----
NAGA_WHATSAPP_TOKEN=
NAGA_WHATSAPP_PHONE_NUMBER_ID=
NAGA_WHATSAPP_APP_SECRET=

# ---- Tounesimmo ----
TOUNESIMMO_WHATSAPP_TOKEN=
TOUNESIMMO_WHATSAPP_PHONE_NUMBER_ID=
TOUNESIMMO_WHATSAPP_APP_SECRET=
