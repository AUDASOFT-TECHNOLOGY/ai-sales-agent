# Names only, never real values. Copy to .env locally (it is git-ignored).
# Client secrets are referenced BY NAME from clients/<client>/client.yaml.

# ---- process settings (all optional) ----
# SALES_AGENT_CLIENTS_DIR=clients
# SALES_AGENT_LOG_LEVEL=INFO
# Highest mode any client may run in. Default "approval": autonomous mode is impossible
# unless the deployment sets SALES_AGENT_MODE_CEILING=autonomous.
# SALES_AGENT_MODE_CEILING=approval
# SALES_AGENT_HOST=127.0.0.1
# SALES_AGENT_PORT=8000
# SALES_AGENT_LOCK_FILE=.sales-agent.lock

# ---- shared ----
OPENAI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json
# Meta webhook subscription check (GET /webhooks/whatsapp)
WHATSAPP_VERIFY_TOKEN=

# ---- Naga ----
NAGA_WHATSAPP_TOKEN=
NAGA_WHATSAPP_PHONE_NUMBER_ID=
NAGA_WHATSAPP_APP_SECRET=

# ---- Tounesimmo ----
TOUNESIMMO_WHATSAPP_TOKEN=
TOUNESIMMO_WHATSAPP_PHONE_NUMBER_ID=
TOUNESIMMO_WHATSAPP_APP_SECRET=
