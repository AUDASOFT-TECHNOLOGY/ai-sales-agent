.ruff_cache/
*.egg-info/
dist/
build/

# Secrets and credentials
.env
.env.*
!.env.example
credentials/
service-account*.json

# OS / IDE
.DS_Store
Thumbs.db
.idea/

# Versioned client settings written at runtime (client business data; back it up, do not commit)
/config/

# Admin Revansa accounts and sessions written at runtime (password hashes; back it up, do not commit)
/admin/
web/admin/

# Encrypted credential store and its audit trail (see sales_app.secret_store; back it up, do not commit)
/secrets/

# Client account profiles written at runtime (password hashes; back it up, do not commit)
/profiles/

# Web (REVENSA frontend prototype)
web/node_modules/
web/dist/
web/.verify/
web/.verify-dev.log

# local files
.claude/worktrees/
.sales-agent.lock
web/.vitest/
